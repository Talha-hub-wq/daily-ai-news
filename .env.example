# Local Ollama inference (no API key required)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.3
# Optional bearer token for your secured hosted Ollama proxy
LLM_API_TOKEN=
# Required only for HTTP triggering and reading /logs; keep private
TRIGGER_TOKEN=

# News and email credentials: populate privately in .env
NEWSAPI_KEY=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SCHEDULE_TIME=12:15
SCHEDULE_TIMEZONE=Asia/Karachi

# Optional external scheduler setup; never reuse an administrator Git token here.
# Use a fine-grained token for this repository with Actions read/write only.
CRONJOB_API_KEY=
GITHUB_DISPATCH_TOKEN=
